        "pcscope/crates/storage/src/lib.rs",
        "pcscope/crates/storage/src/evidence.rs",
        "pcscope/crates/storage/src/identity.rs",
        "pcscope/crates/storage/src/projection.rs",
        "pcscope/crates/storage/src/timeline_policy.rs",
        "pcscope/crates/storage/src/collection.rs",
        "pcscope/crates/storage/src/collection_runs.rs",
        "pcscope/crates/storage/src/collection_runs_tests.rs",
        "pcscope/crates/storage/src/coverage.rs",
        "pcscope/crates/storage/src/item_controls.rs",
        "pcscope/crates/storage/src/related.rs",
        "pcscope/crates/storage/src/registration_dictionary.rs",
        "pcscope/crates/storage/src/registration_dictionary.json",
        "pcscope/crates/storage/src/search_index.rs",
        "pcscope/crates/storage/src/display.rs",
        "pcscope/crates/storage/src/display_counts.rs",
        "pcscope/crates/storage/src/display_tests.rs",
        "pcscope/crates/storage/src/read_index_tests.rs",
        "pcscope/crates/storage/src/self_activity.rs",
        "pcscope/crates/storage/src/flow.rs",
        "pcscope/crates/storage/Cargo.toml",
        "pcscope/crates/contracts/src/reference.rs",
        "pcscope/scripts/build-parallel-boundaries.cjs",
        "pcscope/scripts/build-lifecycle-audit.cjs"
      ],
      "must_not_modify": [
        "前端展示规则",
        "其他类型专属的来源解析"
      ]
    },
    {
      "id": "type-adapters",
      "name": "类型适配线",
      "owns": [
        "pcscope/crates/contracts/src/adapters/**",
        "pcscope/fixtures/**",
        "pcscope/scripts/build-fixtures.cjs"
      ],
      "reserved": [
        "pcscope/crates/adapters/**"
      ],
      "must_not_modify": [
        "schema 编号",
        "最终对象 ID 算法",
        "公共枚举"
      ]
    },
    {
      "id": "query-ui",
      "name": "查询与界面线",
      "owns": [
        "pcscope/crates/ipc/**",
        "pcscope/crates/storage/src/query.rs",
        "pcscope/crates/storage/src/query_views.rs",
        "pcscope/crates/storage/src/history_labels.rs",
        "pcscope/scripts/audit-history-readability.cjs",
        "pcscope/apps/desktop/ui/**",
        "pcscope/apps/desktop/src-tauri/**",
        "pcscope/scripts/check-collection-view.cjs",
        "pcscope/scripts/check-model-view.cjs",
        "pcscope/scripts/check-source-type-map.cjs",
        "pcscope/scripts/check-query-consumers.cjs",
        "pcscope/scripts/check-query-queue.cjs",
        "pcscope/scripts/measure-query-performance.cjs",
        "pcscope/scripts/measure-webview-performance.cjs",
        "pcscope/scripts/measure-timeline-group-performance.cjs",
        "pcscope/scripts/measure-timeline-replay.cjs",
        "pcscope/scripts/check-auto-page.cjs",
        "pcscope/scripts/check-timeline-pages.cjs",
        "pcscope/scripts/check-overview-load.cjs",
        "pcscope/scripts/check-status-issues.cjs",
        "pcscope/scripts/check-status-issues-ui.cjs",
        "pcscope/scripts/check-object-tree-ui.cjs",
        "pcscope/scripts/build-source-type-map.cjs",
        "pcscope/scripts/check-readable-details.cjs",
        "pcscope/scripts/check-snapshot-diff.cjs",
        "pcscope/scripts/check-front-refresh.cjs",
        "pcscope/scripts/check-backend-connection.cjs",
        "pcscope/scripts/check-monitoring-ui.cjs",
        "pcscope/scripts/check-product-status-copy.cjs",
        "pcscope/scripts/check-object-names.cjs",
        "pcscope/scripts/check-object-name-rules.cjs",
        "pcscope/scripts/check-account-presentation.cjs",
        "pcscope/scripts/check-state-first-plan.cjs",
        "pcscope/scripts/check-object-interactions.cjs",
        "pcscope/scripts/open-preview.ps1",
        "pcscope/scripts/prepare-desktop-preview.ps1",
        "pcscope/scripts/prepare-debug-runtime.ps1",
        "pcscope/scripts/build-debug-desktop.ps1",
        "pcscope/scripts/check-settings-isolation.cjs",
        "pcscope/scripts/check-source-gaps.cjs",
        "pcscope/scripts/generate-presentation.cjs",
        "pcscope/scripts/check-state-presentation.cjs"
      ],
      "must_not_modify": [
        "原始证据语义",
        "适配器私有格式"
      ]
    },
    {
      "id": "migration",
      "name": "迁移验证线",
      "owns": [
        "pcscope/crates/cli/**",
        "pcscope/crates/storage/src/reconcile.rs",
        "pcscope/crates/storage/src/faults.rs",
        "pcscope/crates/storage/examples/**",
        "pcscope/scripts/archive-legacy-store.cjs"
      ],
      "must_not_modify": [
        "运行库数据",
        "用户配置",
        "未协调的保留规则"
      ]
    },
    {
      "id": "existing-runtime",
      "name": "既有采集运行实现（不属于本次四条工作线）",
      "owns": [
        "pcscope/crates/service/**",
        "pcscope/crates/supervisor/**",
        "pcscope/plugins/**",
        "pcscope/scripts/stage-dev.ps1",
        "pcscope/scripts/test-*.ps1",
        "pcscope/scripts/test-native-network.cjs",
        "pcscope/scripts/test-native-tasks.cjs",
        "pcscope/scripts/test-native-registry.cjs",
        "pcscope/scripts/test-native-application-fixtures.cjs",
        "pcscope/scripts/test-native-logon.cjs",
        "pcscope/scripts/test-native-mihomo.cjs",
        "pcscope/scripts/check-item-controls.cjs",
        "pcscope/scripts/check-plugin-sources.cjs",
        "pcscope/scripts/check-source-inventory.cjs",
        "pcscope/scripts/check-event-*.cjs",
        "pcscope/scripts/check-evidence.cjs",
        "pcscope/scripts/check-wmi-presentation.cjs",
        "pcscope/scripts/check-item-query-skips.ps1",
        "pcscope/scripts/export-collector-schema.ps1",
        "pcscope/scripts/build-collection-catalog.cjs",
        "pcscope/scripts/build-native-migration.cjs",
        "pcscope/scripts/build-data-display-reference.cjs",
        "pcscope/scripts/data-display-glossary.cjs",
        "pcscope/scripts/test-native-docker.cjs",
        "pcscope/scripts/check-native-provisioned-public.cjs",
        "pcscope/scripts/check-native-enhanced-assessment.cjs",
        "pcscope/scripts/test-native-eventlog-only.cjs"
      ],
      "note": "并行方案只列了四条工作线。服务、监督进程、现有采集插件与既有检查脚本不属于其中任何一条，单列在此以免出现无人认领的空白；改动它们需要与对应整合责任人确认。"
    }
  ],
  "shared_entry_points": [
    {
      "area": "中立模型目录",
      "paths": [
        "pcscope/model/**"
      ],
      "integrator": "base-data",
      "generated_by": "pcscope/scripts/check-model-catalog.cjs",
      "rule": "只修改 model/*.cjs 编写源，随后运行生成器；不手工修改生成结果。版本号在 model/vocabulary.cjs 与 crates/contracts/src/model.rs 两处，必须一起改。 model/presentation.json 是人工维护的类型展示配置；scripts/generate-presentation.cjs 生成 UI 镜像，后端直接嵌入同份配置。"
    },
    {
      "area": "公共契约",
      "paths": [
        "pcscope/crates/contracts/src/adapter.rs",
        "pcscope/crates/contracts/src/identity.rs",
        "pcscope/crates/contracts/src/semantics.rs",
        "pcscope/crates/contracts/src/query.rs",
        "pcscope/crates/contracts/src/model.rs",
        "pcscope/crates/contracts/src/lib.rs",
        "pcscope/crates/contracts/src/sensitive.rs",
        "pcscope/crates/contracts/examples/**",
        "pcscope/crates/contracts/Cargo.toml",
        "pcscope/Cargo.toml",
        "pcscope/Cargo.lock",
        "pcscope/crates/contracts/src/event_state.rs"
      ],
      "integrator": "base-data",
      "generated_by": null,
      "rule": "删除字段、改枚举、改身份或时间语义属破坏性变更，先停止依赖旧语义的集成再统一升级；只增加兼容字段时更新版本与样例。契约示例是验收证据，改动意味着重新走对应步骤的检查。"
    },
    {
      "area": "数据库 schema 与迁移号",
      "paths": [
        "pcscope/crates/storage/src/model.rs"
      ],
      "integrator": "base-data",
      "generated_by": null,
      "rule": "结构与迁移号在 model.rs 定义，迁移块在 storage/src/lib.rs 执行；两者同属一个整合责任人，其他工作线通过声明提出需求，不自行编号。"
    },
    {
      "area": "契约检查",
      "paths": [
        "pcscope/scripts/check-model-catalog.cjs",
        "pcscope/scripts/check-query-contract.cjs",
        "pcscope/scripts/check-contract-cases.cjs",
        "pcscope/scripts/check-ownership.cjs",
        "pcscope/scripts/check-drill.cjs",
        "pcscope/scripts/check-adapter-coverage.cjs",
        "pcscope/scripts/check-history-state.cjs"
      ],
      "integrator": "base-data",
      "generated_by": null,
      "rule": "检查脚本的添加与放宽都需要说明理由；不得为了让某次改动通过而放宽既有规则。"
    },
    {
      "area": "文档与仓库元数据",
      "paths": [
        "pcscope/docs/**",
        "pcscope/README.md",
        "pcscope/AGENTS.md",
        "pcscope/.gitignore",
        "pcscope/build.ps1",
        "pcscope/scripts/verify-workstream.ps1"
      ],
      "integrator": "base-data",
      "generated_by": null,
      "rule": "验收记录不改写已提交的历史结论，需要更正时追加新的记录。构建与验证入口（build.ps1、verify-workstream.ps1）同属此处，改动会影响所有工作线。"
    }
  ],
  "generated": [
    {
      "path": "pcscope/model/catalog.json",
      "generator": "pcscope/scripts/check-model-catalog.cjs"
    },
    {
      "path": "pcscope/model/sources.json",
      "generator": "pcscope/scripts/check-source-inventory.cjs"
    },
    {
      "path": "pcscope/model/query-samples.json",
      "generator": "pcscope/crates/contracts/examples/query-contract.rs"
    },
    {
      "path": "pcscope/model/contract-observed.json",
      "generator": "pcscope/crates/contracts/examples/contract-cases.rs"
    },
    {
      "path": "pcscope/model/adapter-coverage.json",
      "generator": "pcscope/crates/contracts/examples/adapter-coverage.rs"
    },
    {
      "path": "pcscope/apps/desktop/ui/source-type-map.json",
      "generator": "pcscope/scripts/build-source-type-map.cjs"
    },
    {
      "path": "pcscope/apps/desktop/ui/collection-catalog.json",

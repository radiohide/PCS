    },
    {
      "path": "pcscope/apps/desktop/ui/collection-controls.json",
      "generator": "pcscope/scripts/build-collection-catalog.cjs"
    },
    {
      "path": "pcscope/docs/refactor/parallel-boundaries.md",
      "generator": "pcscope/scripts/build-parallel-boundaries.cjs"
    },
    {
      "path": "pcscope/apps/desktop/ui/type-presentation-data.js",
      "generator": "pcscope/scripts/generate-presentation.cjs"
    }
  ],

      "pattern": "pcscope.desktop.*",
      "workstream": "type-adapters",
      "step": "S20",
      "note": "桌面与应用集成"
    },
    {
      "pattern": "pcscope.eventlog.*",
      "workstream": "type-adapters",
      "step": "S21",
      "note": "全部日志通道由同一个事件证据适配器处理；它产出的类型分属多个类别，但适配器只有一个归属，这正是重叠类型的主实现归属"
    },
    {
      "pattern": "pcscope.usn.*",
      "workstream": "base-data",
      "step": "S05",
      "note": "USN 证据入口与断点，属基础数据线"
    },
    {
      "pattern": "pcscope.collector.*",
      "workstream": "base-data",
      "step": "S05",
      "note": "采集器自身状态来源"
    }
